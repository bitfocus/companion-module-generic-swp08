{
	"name": "generic-swp08",
	"version": "4.1.2",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "npm run build && companion-module-build",
		"build": "rimraf dist && npm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:types": "tsc -p tsconfig.json --noEmit"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-generic-swp08.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"lodash": "^4.18.1",
		"p-queue": "^10.0.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.1",
		"@types/lodash": "^4.17.27",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": "^26.13.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	}
}
