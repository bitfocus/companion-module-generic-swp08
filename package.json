{
	"name": "generic-swp08",
	"version": "4.0.7",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-generic-swp08.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.2",
		"lodash": "^4.18.1",
		"p-queue": "^9.3.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.2",
		"@types/lodash": "^4.17.24",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": "^26.5.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.1",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	}
}
